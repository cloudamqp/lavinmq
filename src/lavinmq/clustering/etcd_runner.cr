require "../etcd"
require "./runner"
require "./etcd_coordinator"
require "wait_group"

# Leader election and ISR storage in an external etcd cluster.
class LavinMQ::Clustering::EtcdRunner < LavinMQ::Clustering::Runner
  getter coordinator : EtcdCoordinator

  # Granted by #run for each term, released by #stop from the shutdown fiber
  @lease = Atomic(Etcd::Lease?).new(nil)
  # Makes ending a term's following and the follower monitor setting a
  # replication client one step each, see #stop_following
  @follow_lock = Mutex.new

  def self.new(config : Config)
    etcd = Etcd.new(config.clustering_etcd_endpoints)
    new(config, etcd, EtcdCoordinator.new(config, etcd))
  end

  def initialize(config : Config, @etcd : Etcd, @coordinator : EtcdCoordinator)
    super(config, Runner.clustering_id(config))
    # Closed by #stop
    @stopped = Channel(Nil).new
  end

  # Follows the leader, and yields to start serving whenever this node is
  # elected. When its lease expires the broker is stopped (see #on_demote),
  # and this node grants itself a new lease and follows again, all in this
  # process. Returns once stopped.
  def run(& : Replicator? -> _)
    # Generated by the first node, before any can lead: followers read it once
    # they see a leader, and a watch for it would miss a write made meanwhile
    @coordinator.password
    loop do
      lease = @etcd.lease_grant(ttl: @config.clustering_etcd_lease_ttl, id: @id)
      @lease.set(lease)
      if @stopping.get # #stop released the previous lease, if any
        lease.release rescue nil
        return
      end
      # Set once this term's startup begins, from when a lost lease stops
      # serving instead of exiting, see #watch_lease
      leading = BoolChannel.new(false)
      lost = Channel(Nil).new
      watched = WaitGroup.new
      watched.spawn(name: "Lease watcher") { watch_lease(lease, leading, lost) }
      # This term's, a follower monitor of an earlier term stops at its next
      # event, see #follow_leader_changes
      elected = BoolChannel.new(false)
      spawn(name: "Follower monitor") { follow_leader { follow_leader_changes(elected) } }
      if !wait_to_be_insync(lease) || @stopping.get
        lease.release if @stopping.get # #stop has no lease to release if it came before the grant
        watched.wait                   # exits if it was lost, see #watch_lease
        return
      end
      unless campaign # blocks until becoming leader, or stopped
        watched.wait  # #stop released the lease
        return
      end
      stop_following(elected)
      ensure_in_isr!
      # A stop before this point, e.g. while the replication client closed,
      # must not make this node leader: it would set the ISR to only itself
      if @stopping.get
        lease.release # #stop has no lease to release if it came before the grant
        watched.wait
        return
      end
      leading.set(true)
      execute_shell_command(@config.clustering_on_leader_elected, "leader_elected")
      replicator = new_replicator
      lead(replicator, lost) { yield replicator }
      execute_shell_command(@config.clustering_on_leader_lost, "leader_lost")
      return if @stopping.get
      Log.warn { "Lost leadership, continuing as a follower" }
      # Revoked to stop its keepalive, in case leadership was lost some other
      # way, while this node stops serving: revoking retries while etcd is
      # unavailable, which is when leases get lost. The next term's lease has
      # the same id, so it's granted once this one is gone.
      released = Channel(Nil).new
      spawn(name: "Revoke lost lease") do
        lease.release rescue nil
      ensure
        released.close
      end
      demote(nil)
      released.receive?
    end
  rescue Etcd::LeaseAlreadyExists
    Log.fatal { "Cluster ID #{@id.to_s(36)} used by another node" }
    exit 3
  rescue Etcd::LeaseNotFound
    Log.fatal { "Lease not found, etcd may have been reset" }
    exit 3
  end

  # Serves until leadership is lost, *lost* is closed then, see
  # #watch_lease, or #stop releases the lease. Replicated writes fail once
  # leadership is lost, which ends a startup that waits for them, but exits
  # if it hangs on something else.
  #
  # Also stops serving when the coordinator says this node isn't the leader
  # anymore while the lease lives, e.g. if its election key was deleted:
  # nothing can be confirmed then. The lease is revoked after, see #run.
  private def lead(replicator : Server, lost : Channel(Nil), &) : Nil
    started = Channel(Nil).new
    spawn(watchdog(started, "Lost leadership while starting to serve, and the startup didn't stop, exiting",
      armed: lost), name: "Startup watchdog")
    begin
      yield
    ensure
      started.close
    end
    listen(replicator)
    select
    when lost.receive?
    when replicator.when_fenced.receive?
      Log.warn { "Not the leader anymore according to etcd, while the lease lives" }
    end
  rescue Coordinator::StaleLeadership
    # Lost while starting to serve, replicated writes during startup fail
    # with it, also when a fenced replicator or the Persister raises it
  end

  # Exits when the lease is lost before this node leads, as etcd answers a
  # campaign on an expired lease as won. Once it leads (*leading*) it closes
  # *lost* instead, and this node stops serving and follows again, see #lead.
  # The lease is lost when etcd reports it gone, or no keepalive succeeded
  # within the TTL, see Etcd::Lease#wait.
  private def watch_lease(lease : Etcd::Lease, leading : BoolChannel, lost : Channel(Nil)) : Nil
    loop do
      lease.wait(1.hour) # blocks until the lease expires (raises Expired)
    end
  rescue ex : Etcd::Lease::Expired
    return if @stepping_down.get
    return lost.close if leading.value
    unless @stopping.get
      Log.fatal { "Lease expired: #{ex.cause.try(&.message) || ex.message}" }
      exit 3
    end
  end

  # Set by #ensure_in_isr! before it releases the lease, so the lease watcher
  # doesn't take that for a lost lease
  @stepping_down = Atomic(Bool).new(false)

  def stop
    client = @follow_lock.synchronize do
      @stopping.set(true)
      @repli_client.swap(nil)
    end
    @stopped.close
    client.try &.close
    begin
      @lease.get.try &.release
    rescue ex
      Log.warn(exception: ex) { "Failed to release lease while stopping, it will expire on its own" }
    end
  end

  # Captures the fencing token. False if stopped first: the campaign is a
  # long poll that releasing the lease doesn't end, as etcd waits for the
  # current leader's key, not ours. The process exits after #run returns.
  private def campaign : Bool
    result = Channel(Exception?).new(1)
    spawn(name: "Leader campaign") do
      @coordinator.campaign(@advertised_uri, @id)
      result.send nil
    rescue ex
      result.send ex
    end
    select
    when ex = result.receive
      raise ex if ex
      true
    when @stopped.receive?
      false
    end
  end

  # This node was elected in the term of *elected*: its follower monitor
  # sets no replication client from here on, and it stops at its next event
  private def stop_following(elected : BoolChannel) : Nil
    client = @follow_lock.synchronize do
      elected.set(true)
      @repli_client.swap(nil)
    end
    client.try &.close
    leader_changed # connections wait for this node to serve
  end

  # Follows whoever leads until this node is elected in the term of
  # *elected*, see #stop_following
  private def follow_leader_changes(elected : BoolChannel)
    @etcd.elect_listen("#{@config.clustering_etcd_prefix}/leader") do |uri|
      return if elected.value || @stopping.get
      if repli_client = @repli_client.get # is currently following a leader
        if repli_client.follows? uri
          next # if lost connection to etcd we continue follow the leader as is
        else
          # #run or #stop may have taken it, and closes it then
          taken = @follow_lock.synchronize { @repli_client.compare_and_set(repli_client, nil)[1] }
          repli_client.close if taken
          leader_changed
        end
      end
      if uri.nil? # no leader yet
        Log.warn { "No leader available" }
        next
      end
      if same_node?(uri, @advertised_uri) # if this instance has become leader
        select
        when elected.when_true.receive
          Log.debug { "Elected leader, don't replicate from self" }
          return
        when timeout(1.second)
          raise Error.new("Another node in the cluster is advertising the same URI")
        end
      end
      return unless follow(uri, elected)
    end
  end

  # Starts replicating from the leader at *uri*. False if this node was
  # elected in the term of *elected* meanwhile, e.g. while waiting for the
  # secret.
  private def follow(uri : String, elected : BoolChannel) : Bool
    Log.info { "Leader: #{uri}" }
    key = "#{@config.clustering_etcd_prefix}/clustering_secret"
    secret = @etcd.get(key)
    until secret # the leader might not have had time to set the secret yet
      Log.debug { "Clustering secret is missing, watching for it" }
      @etcd.watch(key) do |value|
        secret = value
        break
      end
    end
    # Only made when it's used: it opens the data dir and takes over
    # checksums.sha1
    r = @follow_lock.synchronize do
      next if elected.value || @stopping.get
      client = Clustering::Client.new(@config, @id, secret)
      client.on_leader_change = ->leader_changed
      @repli_client.set(client)
      client
    end
    return false unless r
    spawn r.follow(uri), name: "Clustering client #{uri}"
    SystemD.notify_ready
    true
  end

  # A queued election candidacy can outlive ISR membership: this node may have
  # been dropped from the ISR (lagging or disconnected replication) after it
  # campaigned, and etcd's election doesn't consult the ISR key. Serving as
  # leader while missing confirmed messages would lose them cluster-wide — the
  # in-sync nodes would full_sync from us and delete them. Exit instead: that
  # releases the lease, withdraws the candidacy and lets an in-sync candidate
  # win; on restart wait_to_be_insync blocks until this node is re-synced.
  private def ensure_in_isr! : Nil
    isr = @coordinator.isr
    return if isr.nil? # no ISR recorded yet (fresh cluster)
    return if isr.includes?(@id)
    Log.fatal { "Won the leader election but is not in the in-sync replica set (ISR: #{isr.to_a}), stepping down" }
    # Release the lease explicitly: the election key is bound to it, so this
    # revokes the just-won leadership at once instead of leaving the cluster
    # leaderless until the lease TTL expires.
    @stepping_down.set(true)
    begin
      @lease.get.try &.release
    rescue ex
      Log.warn(exception: ex) { "Failed to release lease while stepping down, it will expire on its own" }
    end
    exit 3
  end

  # False if the lease ended first, lost or released by #stop
  def wait_to_be_insync(lease : Etcd::Lease) : Bool
    if isr = @coordinator.isr
      unless isr.includes?(@id)
        Log.info { "ISR: #{isr.to_a}" }
        Log.info { "Not in sync, waiting for a leader" }
        in_sync = Channel(Nil).new
        spawn do
          @coordinator.watch_isr do |members|
            if members.try &.includes?(@id)
              in_sync.close
              break
            end
          end
        end
        select
        when lease.expired.receive?
          return false
        when in_sync.receive?
          Log.info { "In sync with leader" }
        end
      end
    end
    true
  end
end
