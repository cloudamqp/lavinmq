[
  {
    "name": "transient-1to1",
    "protocol": "amqp",
    "metrics": [
      "pub",
      "consume",
      "rss"
    ],
    "args": [
      "-u",
      "perf-baseline",
      "-x",
      "1",
      "-y",
      "1"
    ],
    "why": "Baseline publish, route, store and deliver path with small transient messages"
  },
  {
    "name": "persistent-1to1",
    "protocol": "amqp",
    "metrics": [
      "pub",
      "consume",
      "rss",
      "write"
    ],
    "args": [
      "-u",
      "perf-persistent",
      "-x",
      "1",
      "-y",
      "1",
      "-p"
    ],
    "why": "Persistent messages to a durable queue, exercising the message store"
  },
  {
    "name": "confirm-1to1",
    "protocol": "amqp",
    "metrics": [
      "pub",
      "consume"
    ],
    "args": [
      "-u",
      "perf-confirm",
      "-x",
      "1",
      "-y",
      "1",
      "-c",
      "1000"
    ],
    "why": "Publisher confirms, exercising the sync and confirm path"
  },
  {
    "name": "confirm-with-background",
    "protocol": "amqp",
    "metrics": [
      "pub",
      "write",
      "disk"
    ],
    "args": [
      "-u",
      "perf-confirm",
      "-x",
      "1",
      "-y",
      "1",
      "-c",
      "1000",
      "-p"
    ],
    "background": [
      {
        "protocol": "amqp",
        "command": "throughput",
        "args": [
          "-u",
          "perf-bg",
          "-x",
          "1",
          "-y",
          "1",
          "-r",
          "50000",
          "-s",
          "1024",
          "-p"
        ]
      }
    ],
    "why": "Confirmed publishes while another client publishes without confirms, so extra syncing shows up as more bytes written per message"
  },
  {
    "name": "large-100kb",
    "protocol": "amqp",
    "metrics": [
      "pub",
      "consume"
    ],
    "args": [
      "-u",
      "perf-large",
      "-x",
      "1",
      "-y",
      "1",
      "-s",
      "100000"
    ],
    "why": "Large bodies, where segment rollover and deletion happen often"
  },
  {
    "name": "dlx-ttl",
    "protocol": "amqp",
    "metrics": [
      "pub",
      "write",
      "disk"
    ],
    "args": [
      "-u",
      "perf-dlx-src",
      "-x",
      "1",
      "-y",
      "0",
      "-s",
      "1024",
      "--queue-args",
      "{\"x-message-ttl\":5,\"x-dead-letter-exchange\":\"\",\"x-dead-letter-routing-key\":\"perf-dlx-dst\"}"
    ],
    "background": [
      {
        "protocol": "amqp",
        "command": "throughput",
        "args": [
          "-u",
          "perf-dlx-src",
          "-x",
          "0",
          "-y",
          "1",
          "-R",
          "1",
          "-a",
          "1",
          "-P",
          "1",
          "--queue-args",
          "{\"x-message-ttl\":5,\"x-dead-letter-exchange\":\"\",\"x-dead-letter-routing-key\":\"perf-dlx-dst\"}"
        ]
      },
      {
        "protocol": "amqp",
        "command": "throughput",
        "args": [
          "-u",
          "perf-dlx-dst",
          "-x",
          "0",
          "-y",
          "1"
        ]
      }
    ],
    "why": "Messages are stored, expire after 5 ms and are dead-lettered to another queue, exercising moved messages and the deletion of the segments they leave; a slow, acking consumer with prefetch 1 declares the source queue so publishes aren't dropped"
  },
  {
    "name": "fanout-1to4",
    "protocol": "amqp",
    "metrics": [
      "pub",
      "consume"
    ],
    "args": [
      "-x",
      "1",
      "-y",
      "4",
      "--exchange",
      "amq.fanout",
      "--queue-pattern",
      "perf-fan-%",
      "--queue-pattern-from",
      "1",
      "--queue-pattern-to",
      "4"
    ],
    "why": "Routing one message to several queues"
  },
  {
    "name": "stream-1to1",
    "protocol": "amqp",
    "metrics": [
      "pub"
    ],
    "args": [
      "-u",
      "perf-stream",
      "-x",
      "1",
      "-y",
      "1",
      "--queue-args",
      "{\"x-queue-type\":\"stream\"}",
      "--consumer-args",
      "{\"x-stream-offset\":\"first\"}",
      "-P",
      "1000",
      "-a",
      "1"
    ],
    "why": "Stream queue publish path; only publish is gated because the consumer falls behind and its rate is noisy"
  },
  {
    "name": "fanin-16to1",
    "protocol": "amqp",
    "metrics": [
      "pub"
    ],
    "args": [
      "-u",
      "perf-fanin",
      "-x",
      "16",
      "-y",
      "1"
    ],
    "why": "Many concurrent publishers on one queue, exercising locking and scheduling across threads"
  },
  {
    "name": "mqtt-1to1",
