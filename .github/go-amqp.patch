@@ -0,0 +1,35 @@
+package amqp_test
+
+import (
+	"fmt"
+	"net/http"
+	"net/url"
+	"os"
+	"strings"
+)
+
+// lavinmqQueue declares the queue over LavinMQ's HTTP API and returns its
+// AMQP 1.0 address. LavinMQ addresses queues as /queues/<name> and does not
+// create them on attach, unlike the broker these tests are written for.
+func lavinmqQueue(name string) string {
+	api := os.Getenv("LAVINMQ_HTTP_URL")
+	if api == "" {
+		api = "http://127.0.0.1:15672"
+	}
+	req, err := http.NewRequest(http.MethodPut, api+"/api/queues/%2F/"+url.PathEscape(name),
+		strings.NewReader(`{"durable":false}`))
+	if err != nil {
+		panic(err)
+	}
+	req.SetBasicAuth("guest", "guest")
+	req.Header.Set("Content-Type", "application/json")
+	resp, err := http.DefaultClient.Do(req)
+	if err != nil {
+		panic(err)
+	}
+	resp.Body.Close()
+	if resp.StatusCode >= 300 {
+		panic(fmt.Sprintf("declaring queue %q: %s", name, resp.Status))
+	}
+	return "/queues/" + url.PathEscape(name)
+}
